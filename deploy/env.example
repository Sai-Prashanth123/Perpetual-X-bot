# Copy to deploy/.env on the server (setup.sh does this and fills in the generated values).
# Quote nothing here — docker compose reads values literally.

# ---- generated by setup.sh
DOMAIN=
PG_PASSWORD=
INTERNAL_TOKEN=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# ---- you fill these in
ANTHROPIC_API_KEY=
XCONSOLE_API_KEY=
XCONSOLE_URL=https://scraping.thought-pilot.co/api
# Web research (comma-separated; the key with most searches left is used)
TAVILY_API_KEYS=
AGENCY_TIMEZONE=Europe/London

# Slack (one app for the whole agency, from slack-app-manifest.json)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=
HQ_SLACK_CHANNEL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
OWNER_SLACK_IDS=

# X developer app (optional until you want one-tap posting)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Models
PX_MODEL=claude-sonnet-5-5
PX_LEARN_MODEL=claude-opus-5-5
